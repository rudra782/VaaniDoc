# Hosted provider for Render (recommended). Keep this key on the backend only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# For local-only Ollama instead, explicitly select it and uncomment the URL.
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b

# Use the conservative extractor without an AI provider:
# AI_PROVIDER=fallback
